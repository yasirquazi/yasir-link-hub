---
// An embossed red wax seal with a monogram and the role pressed around the rim.
// Pure SVG; the emboss is a light copy nudged up-left and a dark copy nudged down-right.
const N = 120;
const blob = 'M' + Array.from({ length: N }, (_, i) => {
  const a = (i / N) * Math.PI * 2;
  const r = 85 + Math.sin(a * 5 + 0.6) * 3.2 + Math.sin(a * 9 + 2.1) * 1.8 + Math.sin(a * 3) * 2.4
    + Math.max(0, Math.sin(a * 2 - 0.9)) ** 8 * 9; // one fatter drip of wax
  return (100 + r * Math.cos(a)).toFixed(1) + ' ' + (100 + r * Math.sin(a)).toFixed(1);
}).join('L') + 'Z';
---
<div class="seal" role="img" aria-label="Wax seal: Product Designer, Bangalore">
  <svg viewBox="0 0 200 200" aria-hidden="true">
    <defs>
      <radialGradient id="wax" cx="38%" cy="32%" r="75%">
        <stop offset="0" stop-color="#c8423c" />
        <stop offset=".55" stop-color="#9c2228" />
        <stop offset="1" stop-color="#5e1016" />
      </radialGradient>
      <radialGradient id="waxPool" cx="50%" cy="50%" r="50%">
        <stop offset=".7" stop-color="#7e171d" />
        <stop offset="1" stop-color="#a42a2e" />
      </radialGradient>
      <!-- top arc reads over the crown; bottom arc reads upright along the base -->
      <path id="sealTop" d="M44 100A56 56 0 0 1 156 100" />
      <path id="sealBot" d="M37 100A63 63 0 0 0 163 100" />
    </defs>

    <path d={blob} fill="url(#wax)" />
    <!-- the pressed disc -->
    <circle cx="101.5" cy="101.5" r="72" fill="none" stroke="#ffd0c0" stroke-opacity=".28" stroke-width="2.5" />
    <circle cx="100" cy="100" r="72" fill="url(#waxPool)" />
    <circle cx="98.6" cy="98.6" r="72" fill="none" stroke="#3a0609" stroke-opacity=".55" stroke-width="2" />
    <circle cx="100" cy="100" r="46" fill="none" stroke="#3a0609" stroke-opacity=".45" stroke-width="1.6" />
    <circle cx="101" cy="101" r="46" fill="none" stroke="#ffd0c0" stroke-opacity=".25" stroke-width="1.4" />

    <!-- rim lettering, pressed in and filled with pale gold so it reads at small sizes -->
    <g font-family="system-ui, -apple-system, Segoe UI, Roboto, sans-serif" font-size="14.5" font-weight="800" letter-spacing="1.6" text-anchor="middle">
      <text fill="#38060a" fill-opacity=".75" transform="translate(.9 1.1)"><textPath href="#sealTop" startOffset="50%">PRODUCT DESIGNER</textPath></text>
      <text fill="#f6dcae"><textPath href="#sealTop" startOffset="50%">PRODUCT DESIGNER</textPath></text>
      <text fill="#38060a" fill-opacity=".75" transform="translate(.9 1.1)"><textPath href="#sealBot" startOffset="50%">BANGALORE</textPath></text>
      <text fill="#f6dcae"><textPath href="#sealBot" startOffset="50%">BANGALORE</textPath></text>
    </g>

    <!-- monogram -->
    <g font-family="'Instrument Serif', Georgia, serif" font-size="50" text-anchor="middle">
      
      <text x="101.3" y="116.5" fill="#38060a" fill-opacity=".8">YQ</text>
      <text x="100" y="115" fill="#f6dcae">YQ</text>
    </g>
    

    <!-- light catching the wax -->
    <ellipse cx="70" cy="58" rx="30" ry="14" transform="rotate(-32 70 58)" fill="#fff" fill-opacity=".12" />
  </svg>
</div>

<style>
  .seal {
    width: 100%; height: 100%;
    filter: drop-shadow(0 3px 2px rgb(60 10 10 / 0.35)) drop-shadow(0 10px 14px rgb(42 22 14 / 0.3));
  }
  .seal svg { display: block; width: 100%; height: 100%; overflow: visible; }
</style>
