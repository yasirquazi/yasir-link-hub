---
// A square tile with concave corners (a classic zellige shape):
// rotating pattern border, gold rim, and inside it the project's
// icon, title and one-line description.
import { patternURL, palette } from '../lib/patterns.js';
import { glyphs } from '../lib/glyphs.js';

interface Props { p: any; variant?: 'card' | 'hero' | 'mini'; }
const { p, variant = 'card' } = Astro.props;
const c = palette[p.group];
const style = [
  `--bg:${c.bg}`,
  `--fg:${c.fg}`,
  `--pat:${patternURL(p.pattern, c.fg)}`,
  `view-transition-name: tile-${p.slug}`,
].join(';');
const icon = glyphs[p.glyph] || glyphs.nib;
---
<div class={`tc tc-${variant}`} style={style}>
  <div class="tc-shape">
    <div class="tc-rim">
      <div class="tc-win">
        <svg class="tc-glyph" viewBox="0 0 24 24" aria-hidden="true">
          {icon.map((d) => <path d={d} pathLength="1" />)}
        </svg>
        {variant === 'card' && (
          <div class="tc-text">
            <span class="tc-title" style={`view-transition-name: t-${p.slug}`}>{p.title}</span>
            <span class="tc-line">{p.tagline}</span>
          </div>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .tc { filter: drop-shadow(0 10px 14px rgb(42 26 20 / 0.16)); }
  .tc-shape {
    position: relative; aspect-ratio: 1; max-width: 100%;
    clip-path: url(#tile); overflow: hidden;
    background: var(--bg);
  }
  /* Oversized pattern layer so it can turn without showing its edges */
  .tc-shape::before {
    content: ''; position: absolute; inset: -45%;
    background: var(--pat) center / 40px 40px;
    animation: spin 140s linear infinite;
  }
  .tc-rim {
    position: absolute; inset: 7%;
    clip-path: url(#tile);
    background: var(--fg);
  }
  .tc-win {
    position: absolute; inset: 1.5px;
    clip-path: url(#tile);
    background: var(--bg);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 7px; padding: 8% 8%;
    text-align: center; color: var(--fg);
  }
  .tc-glyph {
    width: 24%; height: auto; flex: none; overflow: visible;
    fill: none; stroke: var(--fg); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round;
  }
  .tc-glyph path { stroke-dasharray: 1; stroke-dashoffset: 0; }

  .tc-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .tc-title { font-family: var(--serif); font-size: 17.5px; line-height: 1.05; text-wrap: balance; margin: 0 auto; width: fit-content; }
  .tc-line {
    font-size: 11px; line-height: 1.32; opacity: 0.85; text-wrap: balance;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }

  .tc-hero .tc-glyph { width: 34%; stroke-width: 1.1; }
  .tc-mini { filter: none; }
  .tc-mini .tc-rim { inset: 10%; }
  .tc-mini .tc-glyph { width: 52%; stroke-width: 1.8; }
  .tc-mini .tc-shape::before { animation: none; }

  @keyframes spin { to { transform: rotate(360deg); } }
</style>
