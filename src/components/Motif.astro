---
import { rootFrom, depthOf } from '../lib/paths.js';
// A project emblem: base shape + floating symbol, with the tag and name below.
// Built at 180px wide; parents scale it.
import { motifFor } from '../lib/motifs.js';

interface Props { p: any; variant?: 'item' | 'hero'; }
const { p, variant = 'item' } = Astro.props;
const m = motifFor(p.slug);
const style = `--c:${m.c};--c2:${m.c2};--ink:${m.ink};--ms:${m.size}`;
// Blender-rendered artifact, linked relative to the current page so it works on any host
const art = p.art || `${rootFrom(depthOf(Astro.url.pathname))}art/${p.slug}.webp`;
---
<div class={`mo mo-${variant}`} style={style}>
  <div class="mo-art" style={`view-transition-name:card-${p.slug}`}>
    <div class="mo-tilt">
      {art ? (
        <img class="mo-img" src={art} alt="" width="160" height="160" decoding="async" draggable="false" />
      ) : (
        <>
          <svg class="mo-base" viewBox="0 0 160 160" aria-hidden="true" set:html={m.base} />
          <svg class="mo-top" viewBox="0 0 160 160" aria-hidden="true" set:html={m.top} />
        </>
      )}
    </div>
  </div>
  {variant === 'item' && (
    <div class="mo-label">
      <span class="mo-tag">{p.kind}</span>
      <span class="mo-name" style={`view-transition-name:t-${p.slug}`}>{p.title}</span>
    </div>
  )}
</div>

<style is:global>
  .mo { width: 180px; display: flex; flex-direction: column; align-items: center; }
  .mo-art {
    width: 160px; height: 160px; perspective: 600px;
    transform: scale(var(--ms, 1));
  }
  .mo-tilt {
    position: relative; width: 100%; height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.6s var(--ease);
  }
  .mo-tilt svg, .mo-img { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  /* the artifact's shadow is rendered in; the image frame has room around it */
  .mo-img { object-fit: contain; inset: -17%; width: 134%; height: 134%; }
  .mo-base { filter: drop-shadow(0 16px 14px rgb(42 22 14 / 0.32)) drop-shadow(0 2px 0 var(--c2)); }
  .mo-top { transform: translateZ(34px); filter: drop-shadow(0 8px 6px rgb(0 0 0 / 0.3)); }

  .mo svg .m { fill: var(--c); stroke: url(#foil); stroke-width: 2.6; }
  .mo svg .m2 { fill: var(--c2); stroke: url(#foil); stroke-width: 1.6; }
  .mo svg .k { fill: var(--ink); }
  .mo svg .k.o { opacity: 0.75; }
  .mo svg .ks { fill: none; stroke: var(--ink); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .mo svg .ks.dark { stroke: var(--c2); stroke-width: 3; }
  .mo svg .ks.wide { stroke-width: 5; }
  .mo svg .ks.thin { stroke-width: 2.4; opacity: 0.6; }
  .mo svg .ks.stripe { stroke-width: 3; opacity: 0.35; }
  .mo svg .gd { fill: url(#foil); }
  .mo svg .dot { fill: #e3c27a; }
  .mo svg .tag { fill: var(--c2); font: 700 12px/1 var(--sans); }

  .mo-label {
    margin-top: 14px; display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center;
  }
  .mo-tag {
    padding: 4px 9px 3px; border-radius: 999px;
    background: var(--c); color: var(--ink);
    font-size: 9px; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; white-space: nowrap;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.2), 0 2px 0 var(--c2);
  }
  .mo-name { font-family: var(--serif); font-size: 22px; line-height: 1.05; color: var(--ink-main, #2a1a14); max-width: 180px; text-wrap: balance; }

  /* Touch screens: the motif sways gently so its depth shows */
  @media (hover: none) {
    .mo-tilt { animation: mo-sway 8s ease-in-out infinite alternate; animation-delay: var(--sd, 0s); }
  }
  @keyframes mo-sway {
    from { transform: rotateX(10deg) rotateY(-14deg); }
    to { transform: rotateX(-8deg) rotateY(14deg); }
  }
  @media (prefers-reduced-motion: reduce) { .mo-tilt { animation: none !important; } }
</style>
