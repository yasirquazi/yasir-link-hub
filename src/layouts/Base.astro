---
import { ClientRouter } from 'astro:transitions';
import { rootFrom, depthOf, PREVIEW } from '../lib/paths.js';
interface Props { title: string; description: string; preload?: string[]; }
const { title, description, preload = ['instrument-serif-latin-400-normal'] } = Astro.props;
// icons are linked relative to the page, so they work on any host
const R = rootFrom(depthOf(Astro.url.pathname));
const SITE = Astro.site || new URL('https://yasir-link-hub.yasirquazi2000.workers.dev');
const pageURL = new URL(Astro.url.pathname, SITE).href;
const ogImage = new URL('/og.jpg', SITE).href;
const I = R + 'icons/';
const F = R + 'fonts/';
const faces = [
  ['Instrument Serif', 400, 'normal', 'instrument-serif-latin-400-normal'],
  ['Instrument Serif', 400, 'italic', 'instrument-serif-latin-400-italic'],
  ['Cormorant Garamond', 500, 'normal', 'cormorant-garamond-latin-500-normal'],
  ['Cormorant Garamond', 500, 'italic', 'cormorant-garamond-latin-500-italic'],
  ['Cormorant Garamond', 600, 'normal', 'cormorant-garamond-latin-600-normal'],
  ['Cormorant Garamond', 700, 'normal', 'cormorant-garamond-latin-700-normal'],
  ['Cinzel', 500, 'normal', 'cinzel-latin-500-normal'],
  ['Cinzel', 700, 'normal', 'cinzel-latin-700-normal'],
  ['Cinzel Decorative', 700, 'normal', 'cinzel-decorative-latin-700-normal'],
  ['IM Fell English', 400, 'normal', 'im-fell-english-latin-400-normal'],
  ['IM Fell English', 400, 'italic', 'im-fell-english-latin-400-italic'],
].map(([fam, w, st, file]) => `@font-face{font-family:'${fam}';font-weight:${w};font-style:${st};font-display:swap;src:url(${F}${file}.woff2) format('woff2')}`).join('');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2e8d5" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yasir Quazi" />
    <meta property="og:url" content={pageURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Yasir Quazi, Product Designer: a stamp on a burgundy desk with a camera, compass, candle, pen and inkwell." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={pageURL} />
    <link rel="icon" href={I + 'favicon.ico'} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href={I + 'icon-32.png'} />
    <link rel="icon" type="image/png" sizes="192x192" href={I + 'icon-192.png'} />
    <link rel="apple-touch-icon" href={I + 'apple-touch-icon.png'} />
    <link rel="manifest" href={I + 'site.webmanifest'} />
    <meta name="yq-root" content={R} />
    {!PREVIEW && <ClientRouter fallback="swap" />}
    <script>
      // one sound engine for the whole visit, and a way for pages to move without a full reload
      import '../scripts/sound.js';
      import { navigate } from 'astro:transitions/client';
      if (document.querySelector('meta[name="astro-view-transitions-enabled"]')) (window as any).YQnav = navigate;
    </script>
    {preload.map((f) => <link rel="preload" href={F + f + '.woff2'} as="font" type="font/woff2" crossorigin />)}
    <slot name="head" />
    <style set:html={faces}></style>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <linearGradient id="sheen" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".22"/><stop offset=".45" stop-color="#fff" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".25"/></linearGradient>
      <linearGradient id="foil" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#b8862e" /><stop offset=".32" stop-color="#fff0c2" />
        <stop offset=".55" stop-color="#d4aa52" /><stop offset=".8" stop-color="#f6e0a2" />
        <stop offset="1" stop-color="#a7782a" />
      </linearGradient>
      <clipPath id="tile" clipPathUnits="objectBoundingBox">
        <path d="M.1 0H.9A.1 .1 0 0 0 1 .1V.9A.1 .1 0 0 0 .9 1H.1A.1 .1 0 0 0 0 .9V.1A.1 .1 0 0 0 .1 0Z" />
      </clipPath>
    </svg>
    <slot />
  </body>
</html>

<style is:global>
  /* Native cross-page morphing: no JavaScript router. */

  :root {
    --paper: #f2e8d5;
    --paper-2: #e9dcc2;
    --ink: #2a1a14;
    --ink-2: #6a5646;
    --gold: #c9a24b;
    --forest: #1f4d3a;
    --forest-ink: #e8d8ab;
    --oxblood: #6b1d22;
    --oxblood-ink: #e3c27a;
    --cobalt: #1d3b86;
    --cobalt-ink: #eadfc6;
    --serif: 'Instrument Serif', 'Iowan Old Style', Georgia, serif;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    color-scheme: light;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    min-height: 100dvh;
    background: var(--paper);
    color: var(--ink);
    font: 16px/1.55 var(--sans);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  a { color: inherit; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 400; line-height: 1.05; margin: 0; }
  :focus-visible { outline: 2px solid var(--oxblood); outline-offset: 3px; border-radius: 4px; }

  /* ── View transition timing ── */
  ::view-transition-group(*) {
    animation-duration: 0.55s;
    animation-timing-function: var(--ease);
  }
  ::view-transition-old(root), ::view-transition-new(root) { animation-duration: 0.3s; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after, ::view-transition-group(*) {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
