---
import Base from '../layouts/Base.astro';
import Motif from '../components/Motif.astro';
import WaxSeal from '../components/WaxSeal.astro';
import { projects } from '../data/projects.js';
import { toProject } from '../lib/paths.js';

// A plain dot grid behind everything
const dots = `url("data:image/svg+xml,${encodeURIComponent(
  "<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32'><circle cx='16' cy='16' r='1.1' fill='#2a1a14' fill-opacity='.2'/></svg>"
)}")`;
const grain = `url("data:image/svg+xml,${encodeURIComponent(
  "<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .16 0 0 0 0 .1 0 0 0 0 .07 0 0 0 1.7 -.78'/></filter><rect width='160' height='160' filter='url(#n)'/></svg>"
)}")`;
// Each project rings at its own note of a pentatonic scale
const notes = [784, 880, 1047, 1175, 1319, 1568, 1760, 2093];
---
<Base
  title="Yasir Quazi — Product Designer"
  description="Product design portfolio, client websites and apps, and personal projects by Yasir Quazi."
>
  <script is:inline>
    document.documentElement.classList.add('free');
    try { if (sessionStorage.getItem('intro')) document.documentElement.classList.add('seen'); } catch (e) {}
  </script>

  <div id="intro" aria-hidden="true">
    <svg viewBox="-60 -60 120 120">
      <path pathLength="1" d="M-30-30h60v60h-60zM0-42.4 42.4 0 0 42.4-42.4 0z" />
      <circle pathLength="1" r="16" />
      <path pathLength="1" class="ray" d="M0-42.4V-56M42.4 0H56M0 42.4V56M-42.4 0H-56" />
    </svg>
  </div>

  <aside class="note" id="note" aria-label="About">
    <div class="note-in">
      <span class="note-tape" aria-hidden="true"></span>
      <h1>Yasir<br />Quazi</h1>
      <p class="note-sub">My portfolio, client work and personal projects.</p>
      <p class="note-foot">Tap an emblem to open it</p>
    </div>
  </aside>

  <div class="seal-wrap" id="seal"><WaxSeal /></div>

  <div class="vp" id="vp">
    <div class="bgp" id="bgp" style={`background-image:${dots}`} aria-hidden="true"></div>

    <ul class="world" id="world" aria-label="Projects">
      {projects.map((p, i) => (
        <li class="cv-card" data-slug={p.slug} data-pitch={notes[i % notes.length]} style={`--i:${i};--sd:${-i * 1.3}s`}>
          <a class="cv-link" href={'../' + toProject(p.slug)} aria-label={`${p.title}. ${p.kind}. ${p.tagline}`} draggable="false">
            <div class="cv-in"><div class="cv-float"><Motif p={p} /></div></div>
          </a>
        </li>
      ))}
    </ul>

    <!-- Film: warm light leaks and a vignette; grain sits on top of everything -->
    <div class="leak leak-a" aria-hidden="true"></div>
    <div class="leak leak-b" aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>
  </div>

  <p class="hint" id="hint" aria-hidden="true">
    <svg viewBox="0 0 24 24"><path d="M12 3v18M3 12h18M12 3l-3 3M12 3l3 3M12 21l-3-3M12 21l3-3M3 12l3-3M3 12l3 3M21 12l-3-3M21 12l-3 3" /></svg>
    <span class="t-touch">Drag to explore · pinch to zoom</span><span class="t-mouse">Drag to explore · Ctrl + scroll to zoom</span>
  </p>

  <div class="ctrl ctrl-r">
    <button type="button" id="zin" aria-label="Zoom in" title="Zoom in">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12M12 6v12" /></svg>
    </button>
    <button type="button" id="zout" aria-label="Zoom out" title="Zoom out">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12" /></svg>
    </button>
    <button type="button" id="home" aria-label="Back to centre" title="Back to centre">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7.5 16.5 12 12 16.5 7.5 12Z" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" /></svg>
    </button>
    <button type="button" id="snd" aria-pressed="false" aria-label="Sound off" title="Sound">
      <svg class="i-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4Z" /><path d="M17 9l5 6M22 9l-5 6" /></svg>
      <svg class="i-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4Z" /><path d="M17 8.5a5 5 0 0 1 0 7M19.5 6a8.5 8.5 0 0 1 0 12" /></svg>
    </button>
  </div>

  <div class="grain" style={`background-image:${grain}`} aria-hidden="true"></div>

  <script is:inline>
  (function () {
    var html = document.documentElement;
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
    var vp = document.getElementById('vp'), bgp = document.getElementById('bgp'), world = document.getElementById('world');
    var hint = document.getElementById('hint');
    var cards = [].slice.call(document.querySelectorAll('.cv-card')), originals = cards.slice();
    var ins = [];
    var store = function (key, v) { try { if (v === undefined) return localStorage.getItem(key); localStorage.setItem(key, v); } catch (e) {} };
    try { sessionStorage.setItem('from', 'canvas'); } catch (e) {}

    /* ───────── Sound: synthesised with Web Audio, nothing to download ───────── */
    var A = null, noise = null, soundOn = store('sfx') === '1', lastHover = 0;
    function ac() {
      if (!A) {
        var C = window.AudioContext || window.webkitAudioContext; if (!C) return null;
        A = new C();
        noise = A.createBuffer(1, A.sampleRate * 0.6, A.sampleRate);
        var d = noise.getChannelData(0); for (var i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
      }
      if (A.state === 'suspended') A.resume();
      return A;
    }
    function tone(f, peak, dec, type, delay, f2) {
      var a = ac(); if (!a) return; var t = a.currentTime + (delay || 0);
      var o = a.createOscillator(), g = a.createGain();
      o.type = type || 'sine'; o.frequency.setValueAtTime(f, t);
      if (f2) o.frequency.exponentialRampToValueAtTime(f2, t + dec);
      g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(peak, t + 0.006);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dec);
      o.connect(g); g.connect(a.destination); o.start(t); o.stop(t + dec + 0.05);
    }
    function hiss(from, to, peak, dur, q) {
      var a = ac(); if (!a) return; var t = a.currentTime;
      var s = a.createBufferSource(), f = a.createBiquadFilter(), g = a.createGain();
      s.buffer = noise; f.type = 'bandpass'; f.Q.value = q || 1;
      f.frequency.setValueAtTime(from, t); f.frequency.exponentialRampToValueAtTime(to, t + dur);
      g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(peak, t + dur * 0.35);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      s.connect(f); f.connect(g); g.connect(a.destination); s.start(t); s.stop(t + dur + 0.05);
    }
    var sfx = {
      hover: function (p) { tone(p, 0.03, 0.35, 'sine'); tone(p * 2, 0.008, 0.2, 'sine', 0.01); },
      press: function () { tone(380, 0.07, 0.1, 'triangle', 0, 220); },
      open: function () { tone(784, 0.05, 1.2); tone(1176, 0.03, 1.3, 'sine', 0.06); tone(1568, 0.018, 1, 'sine', 0.12); },
      whoosh: function (sp) { hiss(260, 1700, Math.min(0.05, 0.008 + sp * 0.0016), 0.42, 0.8); },
      zoom: function (up) { hiss(up ? 500 : 1800, up ? 1800 : 500, 0.02, 0.28, 2); },
      on: function () { tone(660, 0.05, 0.3); tone(990, 0.04, 0.45, 'sine', 0.09); }
    };
    function play(n, x) { if (soundOn) try { sfx[n](x); } catch (e) {} }

    var snd = document.getElementById('snd');
    function syncSnd() {
      snd.setAttribute('aria-pressed', soundOn); snd.setAttribute('aria-label', soundOn ? 'Sound on' : 'Sound off');
      html.classList.toggle('snd', soundOn);
    }
    syncSnd();
    snd.addEventListener('click', function () { soundOn = !soundOn; store('sfx', soundOn ? '1' : '0'); syncSnd(); play('on'); });
    addEventListener('pointerdown', function () { if (soundOn) ac(); }, { once: true });

    /* ───────── Layout: each project once, scattered at random ───────── */
    var ZMIN = 0.5, ZMAX = 1.8, z = 1;
    var k, cw, ch, vw, vh, base = [], bounds = { x0: 0, x1: 0, y0: 0, y1: 0 };
    var px = 0, py = 0, vx = 0, vy = 0; // pan in canvas units; the canvas origin sits at the screen centre
    function rand(i) { var x = Math.sin(i * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); }
    function mod(a, n) { return ((a % n) + n) % n; }
    function clampZ(v) { return Math.max(ZMIN, Math.min(ZMAX, v)); }

    function layout() {
      vw = innerWidth; vh = innerHeight;
      k = Math.max(0.85, Math.min(1.25, vw / 430));
      cw = 180 * k; ch = 240 * k;
      var wide = vw > 900, n = cards.length;
      // Keep-out areas: the note and the seal, as they sit on screen at the starting view
      var keep = [document.getElementById('note'), document.getElementById('seal'), document.querySelector('.ctrl-r')].map(function (el) {
        return { x0: el.offsetLeft - vw / 2 - 16, y0: el.offsetTop - vh / 2 - 16, x1: el.offsetLeft + el.offsetWidth - vw / 2 + 16, y1: el.offsetTop + el.offsetHeight - vh / 2 + 16 };
      });
      // Scatter at random (same pattern every visit), no overlaps
      var seed = 20261120;
      function rnd() { seed = (seed + 0x6D2B79F5) | 0; var t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t ^= t + Math.imul(t ^ (t >>> 7), 61 | t); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }
      var target = n * cw * ch * (wide ? 3.4 : 2.15), AW = Math.max(vw * 0.95, Math.sqrt(target * vw / vh)), AH = target / AW;
      var gx = cw * 0.1, gy = ch * 0.05;
      function hits(b, r) { return b.x < r.x1 && b.x + cw > r.x0 && b.y < r.y1 && b.y + ch > r.y0; }
      for (var round = 0; round < 30; round++) {
        base = []; var ok = true;
        for (var i = 0; i < n && ok; i++) {
          var placed = false;
          for (var t = 0; t < 500 && !placed; t++) {
            var b = { x: (rnd() - 0.5) * (AW - cw) - cw / 2, y: (rnd() - 0.5) * (AH - ch) - ch / 2 };
            if (keep.some(function (r) { return hits(b, r); })) continue;
            if (base.some(function (o) { return hits(b, { x0: o.x - gx, y0: o.y - gy, x1: o.x + cw + gx, y1: o.y + ch + gy }); })) continue;
            base.push(b); placed = true;
          }
          ok = placed;
        }
        if (ok) break;
        AW *= 1.08; AH *= 1.08;
      }
      cards.forEach(function (c) { c.style.setProperty('--rot', ((rnd() - 0.5) * 14).toFixed(1) + 'deg'); });
      bounds = { x0: Infinity, x1: -Infinity, y0: Infinity, y1: -Infinity };
      base.forEach(function (b) {
        bounds.x0 = Math.min(bounds.x0, b.x); bounds.x1 = Math.max(bounds.x1, b.x + cw);
        bounds.y0 = Math.min(bounds.y0, b.y); bounds.y1 = Math.max(bounds.y1, b.y + ch);
      });
      // Zooming out stops once everything fits on screen
      ZMIN = Math.min(0.95, Math.max(0.35, Math.min(vw / (bounds.x1 - bounds.x0 + 80), vh / (bounds.y1 - bounds.y0 + 160))));
      z = Math.max(z, ZMIN);
      ins = cards.map(function (c) { return c.querySelector('.cv-in'); });
      px = 0; py = 0;
    }

    // How far the view has been dragged past the edge of the work (0 when inside)
    function over() {
      var hx = vw / 2 / z, hy = vh / 2 / z;
      var lo = { x: -(bounds.x1 - hx * 0.5), y: -(bounds.y1 - hy * 0.5) }, hi = { x: -(bounds.x0 + hx * 0.5), y: -(bounds.y0 + hy * 0.5) };
      if (lo.x > hi.x) lo.x = hi.x = -(bounds.x0 + bounds.x1) / 2;
      if (lo.y > hi.y) lo.y = hi.y = -(bounds.y0 + bounds.y1) / 2;
      return { x: px < lo.x ? px - lo.x : px > hi.x ? px - hi.x : 0, y: py < lo.y ? py - lo.y : py > hi.y ? py - hi.y : 0 };
    }

    /* ───────── Render ───────── */
    var pos = [], lastZ = 0;
    function render() {
      var cz = cw * z, hz = ch * z;
      var leanY = Math.max(-16, Math.min(16, vx * 0.9)), leanX = Math.max(-14, Math.min(14, -vy * 0.9));
      var lean = Math.abs(leanX) + Math.abs(leanY) > 0.15 ? 'rotateX(' + leanX.toFixed(2) + 'deg) rotateY(' + leanY.toFixed(2) + 'deg)' : '';
      for (var i = 0; i < cards.length; i++) {
        var x = vw / 2 + (base[i].x + px) * z, y = vh / 2 + (base[i].y + py) * z;
        pos[i] = { x: x, y: y };
        cards[i].style.transform = 'translate3d(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px,0) scale(' + (k * z).toFixed(4) + ')';
        ins[i].style.transform = lean;
      }
      var T = 32 * z;
      if (z !== lastZ) { bgp.style.backgroundSize = T.toFixed(2) + 'px ' + T.toFixed(2) + 'px'; lastZ = z; }
      bgp.style.transform = 'translate3d(' + (mod(vw / 2 + px * z, T) - T).toFixed(1) + 'px,' + (mod(vh / 2 + py * z, T) - T).toFixed(1) + 'px,0)';
    }

    /* ───────── Motion loop: runs only while something moves ───────── */
    var raf = 0, dragging = false, tween = null, lastT = 0, settle;
    function kick() {
      clearTimeout(settle); html.classList.add('moving');
      if (!raf) { lastT = performance.now(); raf = requestAnimationFrame(step); }
    }
    function step(now) {
      var dt = Math.min(3, (now - lastT) / 16.67), out = null; lastT = now;
      if (tween) {
        var t = Math.min(1, (now - tween.t0) / tween.d), e = 1 - Math.pow(1 - t, 4);
        var nx = tween.x0 + tween.dx * e, ny = tween.y0 + tween.dy * e;
        vx = (nx - px) * z / dt * 0.5; vy = (ny - py) * z / dt * 0.5; px = nx; py = ny;
        z = tween.z0 + tween.dz * e;
        if (t >= 1) { tween = null; vx = vy = 0; }
      } else if (!dragging) {
        px += vx * dt / z; py += vy * dt / z;
        var fr = Math.pow(reduce ? 0.6 : 0.935, dt); vx *= fr; vy *= fr;
        // Past the edge: spring back
        out = over();
        if (out.x || out.y) {
          var sp = 1 - Math.pow(0.82, dt);
          px -= out.x * sp; py -= out.y * sp; vx *= 0.6; vy *= 0.6;
          if (Math.abs(out.x) < 0.3) px -= out.x; if (Math.abs(out.y) < 0.3) py -= out.y;
          out = over();
        }
        if (Math.abs(vx) < 0.04 && Math.abs(vy) < 0.04) { vx = vy = 0; }
      } else {
        var dk = Math.pow(0.8, dt); vx *= dk; vy *= dk;
      }
      render();
      var settling = out && (out.x || out.y);
      raf = (dragging || tween || vx || vy || settling) ? requestAnimationFrame(step) : 0;
      if (!raf) settle = setTimeout(function () { html.classList.remove('moving'); }, 450);
    }
    function animateTo(dx, dy, toZ, d) {
      tween = { x0: px, y0: py, dx: dx, dy: dy, z0: z, dz: clampZ(toZ) - z, t0: performance.now(), d: reduce ? 1 : (d || 650) };
      kick();
    }
    function zoomAt(nz, ax, ay) {
      nz = clampZ(nz); if (nz === z) return;
      px += (ax - vw / 2) * (1 / nz - 1 / z); py += (ay - vh / 2) * (1 / nz - 1 / z);
      z = nz;
    }
    function zoomBy(f) { play('zoom', f > 1); animateTo(0, 0, z * f, 420); hideHint(); }
    function toHome() { animateTo(-px, -py, 1, 900); }
    // Dragging past the edge meets resistance
    function dragBy(dx, dy) {
      var o = over();
      px += dx / z * (o.x && Math.sign(dx) === -Math.sign(o.x) ? 0.35 : 1);
      py += dy / z * (o.y && Math.sign(dy) === -Math.sign(o.y) ? 0.35 : 1);
    }

    /* ───────── Input: drag, pinch, wheel/trackpad, keys ───────── */
    var ptrs = {}, np = 0, pinch = null, downX = 0, downY = 0, lx = 0, ly = 0, lt = 0, moved = false;
    function hideHint() { if (!hint.classList.contains('gone')) hint.classList.add('gone'); }
    function clearDown() { var d = world.querySelector('.cv-card.down'); if (d) d.classList.remove('down'); }
    function pinchState() {
      var ids = Object.keys(ptrs), a = ptrs[ids[0]], b = ptrs[ids[1]];
      return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2, d: Math.max(20, Math.hypot(a.x - b.x, a.y - b.y)) };
    }
    vp.addEventListener('pointerdown', function (e) {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      ptrs[e.pointerId] = { x: e.clientX, y: e.clientY }; np = Object.keys(ptrs).length;
      if (np === 1) {
        dragging = true; moved = false; tween = null;
        downX = lx = e.clientX; downY = ly = e.clientY; lt = e.timeStamp; vx = vy = 0;
        var c = e.target.closest('.cv-card'); if (c) { c.classList.add('down'); play('press'); }
      } else if (np === 2) {
        pinch = pinchState(); moved = true; html.classList.add('dragging'); clearDown();
      }
      kick();
    });
    addEventListener('pointermove', function (e) {
      var p = ptrs[e.pointerId]; if (!p) return;
      p.x = e.clientX; p.y = e.clientY;
      if (np >= 2 && pinch) {
        var s = pinchState();
        zoomAt(z * s.d / pinch.d, s.x, s.y);
        px += (s.x - pinch.x) / z; py += (s.y - pinch.y) / z;
        pinch = s; vx = vy = 0; hideHint(); return;
      }
      var dx = e.clientX - lx, dy = e.clientY - ly, dt = Math.max(1, e.timeStamp - lt) / 16.67;
      lx = e.clientX; ly = e.clientY; lt = e.timeStamp;
      dragBy(dx, dy);
      vx = vx * 0.4 + (dx / dt) * 0.6; vy = vy * 0.4 + (dy / dt) * 0.6;
      if (!moved && Math.hypot(lx - downX, ly - downY) > 7) {
        moved = true; html.classList.add('dragging'); hideHint(); clearDown();
      }
    });
    function up(e) {
      if (!ptrs[e.pointerId]) return;
      delete ptrs[e.pointerId]; np = Object.keys(ptrs).length;
      if (np === 1) {
        pinch = null; var r = ptrs[Object.keys(ptrs)[0]];
        lx = r.x; ly = r.y; lt = e.timeStamp; vx = vy = 0;
      } else if (np === 0) {
        pinch = null; dragging = false; html.classList.remove('dragging'); clearDown();
        var sp = Math.hypot(vx, vy); if (moved && sp > 7) play('whoosh', sp);
        kick();
      }
    }
    addEventListener('pointerup', up); addEventListener('pointercancel', up);

    vp.addEventListener('wheel', function (e) {
      e.preventDefault(); tween = null;
      var m = e.deltaMode === 1 ? 16 : 1;
      if (e.ctrlKey || e.metaKey) {
        // Trackpad pinch arrives as ctrl + wheel
        zoomAt(z * Math.exp(-e.deltaY * m * 0.008), e.clientX, e.clientY); vx = vy = 0;
      } else {
        var dx = (e.shiftKey ? e.deltaY : e.deltaX) * m, dy = (e.shiftKey ? 0 : e.deltaY) * m;
        dragBy(-dx, -dy);
        vx = Math.max(-30, Math.min(30, -dx * 0.25)); vy = Math.max(-30, Math.min(30, -dy * 0.25));
      }
      hideHint(); kick();
    }, { passive: false });

    // Safari's own pinch gesture
    var gz = 1;
    vp.addEventListener('gesturestart', function (e) { e.preventDefault(); gz = z; });
    vp.addEventListener('gesturechange', function (e) { e.preventDefault(); zoomAt(gz * e.scale, e.clientX, e.clientY); kick(); });

    addEventListener('keydown', function (e) {
      var s = 220, map = { ArrowLeft: [s, 0], ArrowRight: [-s, 0], ArrowUp: [0, s], ArrowDown: [0, -s] };
      if (map[e.key]) { e.preventDefault(); animateTo(map[e.key][0] / z, map[e.key][1] / z, z, 450); hideHint(); }
      else if (e.key === '+' || e.key === '=') zoomBy(1.3);
      else if (e.key === '-' || e.key === '_') zoomBy(1 / 1.3);
      else if (e.key === '0') toHome();
    });

    // Tabbing to a motif brings it into view
    world.addEventListener('focusin', function (e) {
      var c = e.target.closest('.cv-card'); if (!c) return;
      var p = pos[cards.indexOf(c)];
      animateTo((vw / 2 - (p.x + cw * z / 2)) / z, (vh / 2 - (p.y + ch * z / 2)) / z, z, 600);
    });

    /* ───────── Opening a project ───────── */
    world.addEventListener('click', function (e) {
      var a = e.target.closest('.cv-link'); if (!a) return;
      e.preventDefault();
      if (moved && e.detail !== 0) return; // that was a drag, not a tap
      try { sessionStorage.setItem('last', a.parentNode.dataset.slug); } catch (e2) {}
      play('open');
      setTimeout(function () { location.href = a.href; }, soundOn ? 140 : 0);
    });

    /* ───────── Hover: the motif tilts toward the cursor (mouse only) ───────── */
    function bindHover(c) {
      if (!finePointer) return;
      var art = c.querySelector('.mo-art'), tilt = c.querySelector('.mo-tilt');
      c.addEventListener('pointerenter', function () {
        if (dragging) return;
        c.classList.add('hot');
        var now = performance.now(); if (now - lastHover > 70) { lastHover = now; play('hover', +c.dataset.pitch); }
      });
      c.addEventListener('pointermove', function (e) {
        if (dragging) return;
        var b = art.getBoundingClientRect(), nx = (e.clientX - b.left) / b.width - 0.5, ny = (e.clientY - b.top) / b.height - 0.5;
        tilt.style.transition = 'transform .15s ease-out';
        tilt.style.transform = 'rotateX(' + (-ny * 26).toFixed(1) + 'deg) rotateY(' + (nx * 28).toFixed(1) + 'deg) translateZ(18px)';
      });
      c.addEventListener('pointerleave', function () {
