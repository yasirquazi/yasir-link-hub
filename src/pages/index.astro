---
import Base from '../layouts/Base.astro';
import TileCard from '../components/TileCard.astro';
import { projects } from '../data/projects.js';
import { toProject } from '../lib/paths.js';
---
<Base
  title="Yasir Quazi — Product Designer"
  description="Product design portfolio, client websites and apps, and personal projects by Yasir Quazi."
>
  <script is:inline>
    document.documentElement.classList.add('js');
    try { sessionStorage.removeItem('from'); } catch (e) {}
    try { if (sessionStorage.getItem('intro')) document.documentElement.classList.add('seen'); } catch (e) {}
  </script>

  <!-- Opening: a gold star draws itself, then the curtain lifts -->
  <div id="intro" aria-hidden="true">
    <svg viewBox="-60 -60 120 120">
      <path pathLength="1" d="M-30-30h60v60h-60zM0-42.4 42.4 0 0 42.4-42.4 0z" />
      <circle pathLength="1" r="16" />
      <path pathLength="1" class="ray" d="M0-42.4V-56M42.4 0H56M0 42.4V56M-42.4 0H-56" />
    </svg>
  </div>

  <header class="nav" id="nav">
    <h1 class="name">Yasir Quazi</h1>
    <p class="role">Product Designer based in Bangalore, India</p>
  </header>

  <main class="page">
    <p class="intro-line">Find all my portfolio and other project links here.</p>

    <ul class="feed">
      {projects.map((p, i) => (
        <li class="item" style={`--i:${i}`} data-slug={p.slug}>
          <a href={toProject(p.slug)} aria-label={`${p.title}: ${p.tagline}`}>
            <TileCard p={p} />
          </a>
        </li>
      ))}
    </ul>

    <footer class="foot">© {new Date().getFullYear()} Yasir Quazi</footer>
  </main>

  <script is:inline>
    (function () {
      var html = document.documentElement;

      // Intro: once per session, tap to skip
      if (!html.classList.contains('seen')) {
        try { sessionStorage.setItem('intro', '1'); } catch (e) {}
        var end = function () { html.classList.add('intro-done'); };
        setTimeout(end, 2400);
        document.getElementById('intro').addEventListener('click', end);
      }

      // Header gains its background once the page scrolls
      var nav = document.getElementById('nav'), ticking = false;
      function check() { ticking = false; nav.classList.toggle('stuck', scrollY > 8); }
      addEventListener('scroll', function () {
        if (!ticking) { ticking = true; requestAnimationFrame(check); }
      }, { passive: true });
      check();

      // Return to the card you left through
      var last = null;
      try { last = sessionStorage.getItem('last'); } catch (e) {}
      var el = last && document.querySelector('.item[data-slug="' + last + '"]');
      if (el) { el.scrollIntoView({ block: 'center', behavior: 'instant' }); check(); }

      // Tiles settle in and their icons draw as they come into view
      var wait = html.classList.contains('seen') ? 0 : 1900, t0 = Date.now(), batch = 0, bt;
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          var delay = Math.max(0, wait - (Date.now() - t0)) + batch++ * 90;
          clearTimeout(bt); bt = setTimeout(function () { batch = 0; }, 120);
          setTimeout(function () { e.target.classList.add('in'); }, delay);
        });
      }, { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.item').forEach(function (el) { io.observe(el); });

      document.querySelector('.feed').addEventListener('click', function (e) {
        var item = e.target.closest('.item');
        if (item) try { sessionStorage.setItem('last', item.dataset.slug); } catch (e2) {}
      });
    })();
  </script>
</Base>

<style>
  /* ── Intro ── */
  #intro {
    position: fixed; inset: 0; z-index: 50;
    display: grid; place-items: center;
    background: var(--oxblood);
    animation: lift 0.8s var(--ease) 1.5s forwards;
    cursor: pointer;
  }
  #intro svg { width: min(46vw, 220px); overflow: visible; animation: turn 1.6s var(--ease) forwards; }
  #intro path, #intro circle {
    fill: none; stroke: var(--oxblood-ink); stroke-width: 1.6;
    stroke-dasharray: 1; stroke-dashoffset: 1;
    animation: draw 1s var(--ease) 0.15s forwards;
  }
  #intro circle { animation-delay: 0.6s; }
  #intro .ray { animation-delay: 0.85s; animation-duration: 0.5s; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes turn { from { transform: rotate(-45deg) scale(0.9); } to { transform: none; } }
  @keyframes lift { to { transform: translateY(-100%); visibility: hidden; } }
  :global(.seen) #intro, :global(.intro-done) #intro { display: none; }

  /* ── Sticky header: transparent at rest, solid once scrolling ── */
  .nav {
    position: sticky; top: 0; z-index: 20;
    padding: max(24px, env(safe-area-inset-top)) max(24px, calc(50% - 216px)) 20px;
    display: flex; flex-direction: column; gap: 4px;
    background: rgb(242 232 213 / 0);
    transition: padding 0.35s var(--ease), background-color 0.35s, box-shadow 0.35s;
  }
  .nav.stuck {
    padding-top: max(14px, env(safe-area-inset-top)); padding-bottom: 12px;
    background: var(--paper);
    box-shadow: 0 1px 0 rgb(42 26 20 / 0.1), 0 8px 20px -12px rgb(42 26 20 / 0.25);
  }
  .name { font-size: 26px; line-height: 1.1; transition: font-size 0.35s var(--ease); }
  .nav.stuck .name { font-size: 22px; }
  .role { margin: 0; font-size: 14.5px; color: var(--ink-2); }

  /* ── Page ── */
  .page { max-width: 480px; margin: 0 auto; padding: 0 24px; }
  .intro-line {
    margin: 4px 0 0; padding-bottom: 28px;
    font-size: 15px; color: var(--ink);
  }

  .nav, .intro-line, .feed { animation: rise 0.8s var(--ease) both; }
  .nav { animation-delay: 1.75s; }
  .intro-line { animation-delay: 1.85s; }
  .feed { animation-delay: 1.95s; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } }
  :global(.seen) .nav, :global(.seen) .intro-line, :global(.seen) .feed {
    animation-delay: 0s; animation-duration: 0.4s;
  }

  /* ── Tile grid ── */
  .feed {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px;
  }
  .item a {
    display: block; text-decoration: none; color: inherit;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.25s var(--ease);
  }
  .item a:active { transform: scale(0.96); }
  @media (hover: hover) { .item a:hover { transform: translateY(-3px) rotate(-1deg); } }

  /* Before a tile is in view it waits small and faint; then it settles and its icon draws */
  :global(.js) .item { transition: transform 0.7s var(--ease), opacity 0.7s var(--ease); }
  :global(.js) .item:not(.in) { transform: scale(0.9) rotate(-4deg); opacity: 0; }
  :global(.js) .item :global(.tc-glyph path) { transition: stroke-dashoffset 1.1s var(--ease) 0.15s; }
  :global(.js) .item:not(.in) :global(.tc-glyph path) { stroke-dashoffset: 1; }

  .foot {
    padding: 48px 0 calc(40px + env(safe-area-inset-bottom));
    font-size: 13px; color: var(--ink-2);
  }
</style>
